# Copia como .env (NO lo subas al repositorio) o define estas variables en Render.
PORT=8080
# Secreto HMAC para firmar tokens de sesion (minimo 32 caracteres, aleatorio)
APP_TOKEN_SECRET=
# Origenes permitidos por CORS, separados por coma (dominio real del frontend en Vercel)
CORS_ALLOWED_ORIGINS=http://localhost:5173
AI_MOCK_DELAY_MS=1200
APP_TIME_ZONE=America/Bogota
